{
  "name": "multi-tenant-ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "auth-db:generate": "pnpm run --filter @repo/auth-service db:generate",
    "auth-db:migrate": "pnpm run --filter @repo/auth-service db:migrate",
    "auth-db:push": "pnpm run --filter @repo/auth-service db:push",
    "auth-db:studio": "pnpm run --filter @repo/auth-service db:studio",
    "product-db:generate": "pnpm run --filter @repo/product-service db:generate",
    "product-db:migrate": "pnpm run --filter @repo/product-service db:migrate",
    "product-db:push": "pnpm run --filter @repo/product-service db:push",
    "product-db:studio": "pnpm run --filter @repo/product-service db:studio"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=18"
  }
}
