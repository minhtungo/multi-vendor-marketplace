{
  "name": "multi-tenant-ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "docker:up": "docker-compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker-compose.yml down",
    "docker:logs": "docker-compose -f infra/docker-compose.yml logs -f",
    "auth-db:generate": "pnpm run --filter @repo/auth-service db:generate",
    "auth-db:migrate": "pnpm run --filter @repo/auth-service db:migrate",
    "auth-db:push": "pnpm run --filter @repo/auth-service db:push",
    "auth-db:studio": "pnpm run --filter @repo/auth-service db:studio",
    "product-db:generate": "pnpm run --filter @repo/product-service db:generate",
    "product-db:migrate": "pnpm run --filter @repo/product-service db:migrate",
    "product-db:push": "pnpm run --filter @repo/product-service db:push",
    "product-db:studio": "pnpm run --filter @repo/product-service db:studio",
    "payment-db:generate": "pnpm run --filter @repo/payment-service db:generate",
    "payment-db:migrate": "pnpm run --filter @repo/payment-service db:migrate",
    "payment-db:push": "pnpm run --filter @repo/payment-service db:push",
    "payment-db:studio": "pnpm run --filter @repo/payment-service db:studio",
    "upload-db:generate": "pnpm run --filter @repo/upload-service db:generate",
    "upload-db:migrate": "pnpm run --filter @repo/upload-service db:migrate",
    "upload-db:push": "pnpm run --filter @repo/upload-service db:push",
    "upload-db:studio": "pnpm run --filter @repo/upload-service db:studio",
    "order-db:generate": "pnpm run --filter @repo/order-service db:generate",
    "order-db:migrate": "pnpm run --filter @repo/order-service db:migrate",
    "order-db:push": "pnpm run --filter @repo/order-service db:push",
    "order-db:studio": "pnpm run --filter @repo/order-service db:studio",
    "user-db:generate": "pnpm run --filter @repo/user-service db:generate",
    "user-db:migrate": "pnpm run --filter @repo/user-service db:migrate",
    "user-db:push": "pnpm run --filter @repo/user-service db:push",
    "user-db:studio": "pnpm run --filter @repo/user-service db:studio",
    "vendor-db:generate": "pnpm run --filter @repo/vendor-service db:generate",
    "vendor-db:migrate": "pnpm run --filter @repo/vendor-service db:migrate",
    "vendor-db:push": "pnpm run --filter @repo/vendor-service db:push",
    "vendor-db:studio": "pnpm run --filter @repo/vendor-service db:studio"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=18"
  }
}
